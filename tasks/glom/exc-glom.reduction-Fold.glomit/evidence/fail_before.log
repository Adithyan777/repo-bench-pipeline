                err = copy.copy(e)
                err._set_wrapped(e)
            else:
                err = GlomError.wrap(e)
            if isinstance(err, GlomError):
                err._finalize(scope[LAST_CHILD_SCOPE])
            else:  # wrapping failed, fall back to default behavior
                raise
    
