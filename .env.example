# Copy to .env and fill in. .env is gitignored; secrets are never logged or committed.
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=your-api-key

# Optional model overrides (defaults: Kimi-K2.6 BIG / DeepSeek-V4-Flash SMALL)
# LLM_MODEL_BIG=moonshotai/Kimi-K2.6
# LLM_MODEL_SMALL=deepseek-ai/DeepSeek-V4-Flash-0731

# Tests replay recorded cassettes and need no credentials (LLM_MODE=replay is set by the
# test harness). Set LLM_MODE=record only when re-recording cassettes.
