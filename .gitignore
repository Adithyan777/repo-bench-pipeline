# secrets
.env
.env.*
!.env.example

# assignment inputs (not part of the deliverable)
*.pdf
github-repo-url.txt
target-repo-scan/
target_repo/

# local tooling
.claude/
.DS_Store

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
coverage.json
htmlcov/

# pipeline runtime artifacts
.llm_cache/
scripts/_record_workdir/

# output/: only the glom deliverables are committed — the transformed repo (working tree,
# never its nested .git), the knowledge layer, the report summary and the generated report.
output/*
!output/README.md
!output/glom/
output/glom/*
!output/glom/repo/
output/glom/repo/.git/
!output/glom/knowledge/
output/glom/knowledge/*
!output/glom/knowledge/repo_graph.json
!output/glom/knowledge/.okf/
!output/glom/report_summary.json
!output/glom/REPORT.md

# transcripts/: the final glom run's per-call LLM transcripts, agent trajectories and
# console log are committed as evidence; dev/ holds the methodology notes.

# tasks/: the committed deliverable is the repo-root tasks.json plus the 10 SELECTED task
# folders under tasks/glom/ (see output/glom/tasks/selection.json) and the glom manifest.
/tasks/*
!/tasks/README.md
!/tasks/glom/
/tasks/glom/*
!/tasks/glom/tasks.json
!/tasks/glom/exc-glom.core-format_target_spec_trace/
!/tasks/glom/exc-glom.reduction-Fold.glomit/
!/tasks/glom/exc-glom.grouping-GROUP/
!/tasks/glom/exc-glom.matching-Check.glomit/
!/tasks/glom/hist-94b6375/
!/tasks/glom/hist-e515fb3/
!/tasks/glom/hist-0d75aab/
!/tasks/glom/hist-4a48227/
!/tasks/glom/hist-a32abdd/
!/tasks/glom/hist-c2acc2b/

# fixture repos are rebuilt by tests/fixtures/build_mini_pkg.py; don't commit .git
tests/fixtures/mini_pkg/
tests/fixtures/mini_pkg_notests/
